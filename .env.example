# ─── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── AI provider ───────────────────────────────────────────────────────────────
# Option A (free): OpenRouter — get a key at https://openrouter.ai/keys, uses free models
# (the app tries a few free model slugs automatically, in case OpenRouter retires one —
# set these only to force a specific model as the first choice)
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_TEXT_MODEL=deepseek/deepseek-chat-v3.1:free
# OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-exp:free

# Option B (paid, needed for audio transcription): OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001
